+        XCTAssertTrue(error.localizedDescription.length > 0);
+        [installer performCleanup];
+        XCTAssertEqualObjects([NSData dataWithContentsOfFile:installedInfoPath], originalInfo);
+        XCTAssertEqualObjects([NSData dataWithContentsOfFile:old.executablePath], originalExecutable);
