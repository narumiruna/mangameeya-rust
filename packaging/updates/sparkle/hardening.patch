+static NSUInteger SURemainingMoveFailures;
+static IMP SUOriginalMove;
+static IMP SUOriginalSwap;
+static IMP SUOriginalTaskLaunch;
+static NSTask *SUExtractionTask;
+static dispatch_semaphore_t SUExtractionStarted;
+static NSUInteger SUExtractionLaunches;
+
+// Keep the real child alive with its input pipe open until cancellation. This
+// fixture tests ownership/join, not ZIP parsing or authenticated XPC delivery.
+static BOOL SUHoldExtractionTask(id object, SEL selector, NSError **error)
+{
+    NSTask *task = object;
+    BOOL extraction = [task.launchPath isEqualToString:@"/usr/bin/ditto"];
+    if (extraction) {
+        SUExtractionLaunches++;
+        task.launchPath = @"/bin/sleep";
+        task.arguments = @[@"30"];
+    }
+    BOOL launched = ((BOOL (*)(id, SEL, NSError **))SUOriginalTaskLaunch)(object, selector, error);
+    if (extraction) {
+        SUExtractionTask = task;
+        dispatch_semaphore_signal(SUExtractionStarted);
+    }
+    return launched;
+}
+
+static BOOL SUFailSwap(id object, SEL selector, NSURL *source, NSURL *destination, NSError **error)
+{
+    (void)object; (void)selector; (void)source; (void)destination;
+    if (error != NULL) { *error = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileWriteUnknownError userInfo:nil]; }
+    return NO;
+}
+
+static BOOL SUFailMove(id object, SEL selector, NSURL *source, NSURL *destination, NSError **error)
+{
+    if (SURemainingMoveFailures > 0 && [destination.path isEqualToString:SUFailureDestination]) {
+        SURemainingMoveFailures--;
+        if (error != NULL) { *error = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileWriteUnknownError userInfo:nil]; }
+        return NO;
+    }
+    return ((BOOL (*)(id, SEL, NSURL *, NSURL *, NSError **))SUOriginalMove)(object, selector, source, destination, error);
+}
