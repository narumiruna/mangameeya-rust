+- (void)testCancelExtractionJoinsOwnedChildAndWorker
+{
+    NSURL *root = [self newFixtureDirectory];
+    NSString *archive = [[NSBundle bundleForClass:self.class] pathForResource:@"SparkleTestCodeSignApp" ofType:@"zip"];
+    XCTAssertNotNil(archive);
+    SUPipedUnarchiver *unarchiver = [[SUPipedUnarchiver alloc] initWithArchivePath:archive extractionDirectory:root.path];
+    XCTestExpectation *completed = [self expectationWithDescription:@"Canceled extraction reports failure"];
+    Method launch = class_getInstanceMethod(NSTask.class, @selector(launchAndReturnError:));
+    SUOriginalTaskLaunch = method_getImplementation(launch);
+    SUExtractionStarted = dispatch_semaphore_create(0);
+    SUExtractionLaunches = 0;
+    void (*originalSIGPIPE)(int) = signal(SIGPIPE, SIG_IGN);
+    method_setImplementation(launch, (IMP)SUHoldExtractionTask);
+    @try {
+        [unarchiver unarchiveWithCompletionBlock:^(NSError *error) {
+            XCTAssertNotNil(error);
+            [completed fulfill];
+        } progressBlock:nil waitForCleanup:NO];
+        XCTAssertEqual(dispatch_semaphore_wait(SUExtractionStarted, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC)), 0L);
+        XCTAssertTrue(SUExtractionTask.running);
+        double start = NSProcessInfo.processInfo.systemUptime;
+        [unarchiver cancelAndWait];
+        XCTAssertLessThan(NSProcessInfo.processInfo.systemUptime - start, 5.0);
+        XCTAssertFalse(SUExtractionTask.running);
+        XCTAssertEqual(SUExtractionLaunches, 1U); // No non-piping retry after cancellation.
+        [unarchiver cancelAndWait]; // Idempotent, including after child exit.
+        XCTAssertTrue([NSFileManager.defaultManager removeItemAtURL:root error:NULL]);
+        [self waitForExpectationsWithTimeout:5 handler:nil];
+        XCTAssertFalse([NSFileManager.defaultManager fileExistsAtPath:root.path]);
+    } @finally {
+        [unarchiver cancelAndWait];
+        method_setImplementation(launch, SUOriginalTaskLaunch);
+        signal(SIGPIPE, originalSIGPIPE);
+        SUExtractionTask = nil;
+        SUExtractionStarted = nil;
+        [NSFileManager.defaultManager removeItemAtURL:root error:NULL];
+    }
+}
