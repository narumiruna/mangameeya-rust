+- (SUPlainInstaller *)installerFrom:(NSBundle *)oldBundle to:(NSBundle *)newBundle expectedVersion:(nullable NSString *)expectedVersion
+{
+    SUPlainInstaller *installer = [[SUPlainInstaller alloc] initWithHost:[[SUHost alloc] initWithBundle:oldBundle] bundlePath:newBundle.bundlePath installationPath:oldBundle.bundlePath];
+    installer.requiredArchitecture = self.runningArchitecture;
+    installer.requiredVersion = expectedVersion; // Intended feed metadata, not payload metadata.
+    return installer;
+}
