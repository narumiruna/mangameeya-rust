+- (void)testStrictIdentityArchitectureAndDowngrade
+{
+    NSURL *root = [self newFixtureDirectory];
+    @try {
+        NSBundle *old = [self bundleIn:root name:@"Installed.app" identifier:@"test.sparkle.hardened" version:@"2" architecture:self.runningArchitecture];
+        NSBundle *wrongID = [self bundleIn:root name:@"WrongID.app" identifier:@"test.other" version:@"3" architecture:self.runningArchitecture];
+        NSBundle *wrongArch = [self bundleIn:root name:@"WrongArch.app" identifier:old.bundleIdentifier version:@"3" architecture:self.runningArchitecture == NSBundleExecutableArchitectureX86_64 ? NSBundleExecutableArchitectureARM64 : NSBundleExecutableArchitectureX86_64];
+        NSBundle *downgrade = [self bundleIn:root name:@"Downgrade.app" identifier:old.bundleIdentifier version:@"1" architecture:self.runningArchitecture];
+        for (NSBundle *update in @[wrongID, wrongArch, downgrade]) {
+            SUPlainInstaller *installer = [self installerFrom:old to:update expectedVersion:update == downgrade ? @"1" : @"3"];
+            NSError *error = nil;
+            XCTAssertFalse([installer performInitialInstallation:&error]);
+            XCTAssertNotNil(error);
+            if (update == downgrade) { XCTAssertEqual(error.code, SUDowngradeError); }
+            [installer performCleanup];
+            XCTAssertTrue([NSFileManager.defaultManager fileExistsAtPath:old.executablePath]);
+        }
+    } @finally {
+        [NSFileManager.defaultManager removeItemAtURL:root error:NULL];
+    }
+}
