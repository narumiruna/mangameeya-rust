+- (void)testCommitPolicy
+{
+    uint8_t nonce[SPU_INSTALLATION_NONCE_LENGTH] = {1};
+    uint8_t other[SPU_INSTALLATION_NONCE_LENGTH] = {2};
+    SPUInstallationCommitState state = {0};
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 1));
+    XCTAssertTrue(SPUCommitPrepare(&state, nonce, 1));
+    XCTAssertFalse(SPUCommitAuthorize(&state, other, sizeof(other), 2));
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce) - 1, 2));
+    XCTAssertFalse(SPUCommitBeginFinalInstallation(&state));
+    XCTAssertTrue(SPUCommitDisarm(&state));
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 2));
+    SPUCommitHostTerminated(&state);
+    XCTAssertFalse(SPUCommitBeginFinalInstallation(&state));
+
+    state = (SPUInstallationCommitState){0};
+    XCTAssertTrue(SPUCommitPrepare(&state, nonce, 1));
+    SPUCommitHostTerminated(&state); // Crash/ordinary quit is not COMMIT.
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 2));
+    XCTAssertFalse(SPUCommitBeginFinalInstallation(&state));
+
+    state = (SPUInstallationCommitState){0};
+    XCTAssertTrue(SPUCommitPrepare(&state, nonce, 1));
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 1 + SPU_INSTALLATION_COMMIT_LIFETIME));
+    XCTAssertEqual(state.phase, SPUCommitDisarmed);
+
+    state = (SPUInstallationCommitState){0};
+    XCTAssertTrue(SPUCommitPrepare(&state, nonce, 1));
+    XCTAssertTrue(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 2));
+    XCTAssertFalse(SPUCommitAuthorize(&state, nonce, sizeof(nonce), 2));
+    XCTAssertFalse(SPUCommitDisarm(&state));
+    XCTAssertFalse(SPUCommitBeginFinalInstallation(&state));
+    SPUCommitHostTerminated(&state); // Real process waiter must notify first.
+    XCTAssertTrue(SPUCommitBeginFinalInstallation(&state));
+    XCTAssertFalse(SPUCommitBeginFinalInstallation(&state));
+}
