diff --git a/Autoupdate/SPUInstallationCommitState.h b/Autoupdate/SPUInstallationCommitState.h
new file mode 100644
--- /dev/null
+++ b/Autoupdate/SPUInstallationCommitState.h
@@ -0,0 +1,81 @@
+// Project hardening for Sparkle 2.10.1. No persistent authorization.
+#ifndef SPU_INSTALLATION_COMMIT_STATE_H
+#define SPU_INSTALLATION_COMMIT_STATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define SPU_INSTALLATION_NONCE_LENGTH 16
+#define SPU_INSTALLATION_COMMIT_LIFETIME 300.0
+
+typedef enum {
+    SPUCommitUnprepared = 0,
+    SPUCommitPrepared,
+    SPUCommitAuthorized,
+    SPUCommitDisarmed,
+    SPUCommitInstalling
+} SPUInstallationCommitPhase;
+
+typedef struct {
+    SPUInstallationCommitPhase phase;
+    uint8_t nonce[SPU_INSTALLATION_NONCE_LENGTH];
+    double deadline;
+    bool hostTerminated;
+} SPUInstallationCommitState;
+
+// All calls belong to the installer's main queue. The nonce travels only on
+// the original authenticated XPC connection, never in defaults or argv.
+static inline bool SPUCommitPrepare(SPUInstallationCommitState *state, const void *nonce, double now)
+{
+    if (state->phase != SPUCommitUnprepared || state->hostTerminated) {
+        return false;
+    }
+    memcpy(state->nonce, nonce, sizeof(state->nonce));
+    state->deadline = now + SPU_INSTALLATION_COMMIT_LIFETIME;
+    state->phase = SPUCommitPrepared;
+    return true;
+}
+
+static inline bool SPUCommitAuthorize(SPUInstallationCommitState *state, const void *nonce, size_t length, double now)
+{
+    if (state->phase != SPUCommitPrepared || state->hostTerminated) {
+        return false;
+    }
+    if (now >= state->deadline) {
+        state->phase = SPUCommitDisarmed;
+        return false;
+    }
+    if (length != sizeof(state->nonce) || memcmp(state->nonce, nonce, length) != 0) {
+        return false;
+    }
+    state->phase = SPUCommitAuthorized;
+    return true;
+}
+
+static inline bool SPUCommitDisarm(SPUInstallationCommitState *state)
+{
+    if (state->phase == SPUCommitAuthorized || state->phase == SPUCommitInstalling) {
+        return false;
+    }
+    state->phase = SPUCommitDisarmed;
+    return true;
+}
+
+static inline void SPUCommitHostTerminated(SPUInstallationCommitState *state)
+{
+    state->hostTerminated = true;
+    (void)SPUCommitDisarm(state);
+}
+
+static inline bool SPUCommitBeginFinalInstallation(SPUInstallationCommitState *state)
+{
+    if (state->phase != SPUCommitAuthorized || !state->hostTerminated) {
+        return false;
+    }
+    state->phase = SPUCommitInstalling;
+    return true;
+}
+
+#endif
