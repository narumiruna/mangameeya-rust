+- (void)checkRecoveryWithFailedRestoration:(BOOL)failRestoration
+{
+    NSURL *root = [self newFixtureDirectory];
+    NSString *recoveryPath = nil;
+    Method move = class_getInstanceMethod(SUFileManager.class, @selector(moveItemAtURL:toURL:error:));
+    Method swap = class_getInstanceMethod(SUFileManager.class, @selector(swapItemAtURL:withItemAtURL:error:));
+    SUOriginalMove = method_getImplementation(move);
+    SUOriginalSwap = method_getImplementation(swap);
+    @try {
+        NSBundle *old = [self bundleIn:root name:@"Installed.app" identifier:@"test.sparkle.hardened" version:@"1" architecture:self.runningArchitecture];
+        NSBundle *update = [self bundleIn:root name:@"Update.app" identifier:old.bundleIdentifier version:@"2" architecture:self.runningArchitecture];
+        SUPlainInstaller *installer = [self installerFrom:old to:update expectedVersion:@"2"];
+        NSError *error = nil;
+        XCTAssertTrue([installer performInitialInstallation:&error], @"%@", error);
+        SUFailureDestination = old.bundlePath;
+        SURemainingMoveFailures = failRestoration ? 2 : 1;
+        method_setImplementation(move, (IMP)SUFailMove);
+        method_setImplementation(swap, (IMP)SUFailSwap);
+        XCTAssertFalse([installer performFinalInstallationProgressBlock:nil error:&error]);
+        recoveryPath = error.userInfo[NSFilePathErrorKey];
+        [installer performCleanup];
+        if (failRestoration) {
+            XCTAssertNotNil(recoveryPath);
+            XCTAssertTrue([NSFileManager.defaultManager fileExistsAtPath:[recoveryPath stringByAppendingPathComponent:@"Contents/MacOS/Fixture"]]);
+        } else {
+            recoveryPath = old.bundlePath;
+        }
+        NSDictionary *retained = [NSDictionary dictionaryWithContentsOfFile:[recoveryPath stringByAppendingPathComponent:@"Contents/Info.plist"]];
+        XCTAssertEqualObjects(retained[@"CFBundleVersion"], @"1");
+    } @finally {
+        method_setImplementation(move, SUOriginalMove);
+        method_setImplementation(swap, SUOriginalSwap);
+        SUFailureDestination = nil;
+        [NSFileManager.defaultManager removeItemAtURL:root error:NULL];
+        if (failRestoration && recoveryPath != nil) {
+            [NSFileManager.defaultManager removeItemAtPath:[recoveryPath stringByDeletingLastPathComponent] error:NULL];
+        }
+    }
+}
